# ==============================================================================
# DIGITAL GURU FRANCHISE — SERVER CONFIGURATION (.env.example)
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# Copy this file to .env and configure values appropriate for your environment.

# ------------------------------------------------------------------------------
# SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
API_BASE_URL=https://api.digitalghuru.com/api

# Comma-separated list of allowed CORS origins in production
CORS_ORIGIN=https://franchise.digitalghuru.com,https://app.digitalghuru.com,https://digitalghuru.com,https://admin.digitalghuru.com

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (PostgreSQL / Neon Serverless)
# ------------------------------------------------------------------------------
# In production, use the Neon connection pooler URL with sslmode=require
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require&connection_limit=20&pool_timeout=30"

# ------------------------------------------------------------------------------
# CRYPTOGRAPHIC SECRETS & TOKENS
# ------------------------------------------------------------------------------
# Generate cryptographically secure keys (e.g., openssl rand -base64 48)
JWT_SECRET=replace_with_cryptographically_secure_random_key_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=replace_with_different_cryptographically_secure_random_key
REFRESH_TOKEN_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# STORAGE & FILE UPLOADS
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# If STORAGE_DRIVER=s3 (AWS S3 or Cloudflare R2)
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=digitalghuru-franchise-uploads

# ------------------------------------------------------------------------------
# NOTIFICATIONS & SMS INTEGRATION
# ------------------------------------------------------------------------------
# Supported providers: mock, twilio, msg91
SMS_PROVIDER=mock
# SMS_API_KEY=
# SMS_SENDER_ID=DGGHRU

# ------------------------------------------------------------------------------
# INITIAL SUPER ADMIN SEED PROVISIONING
# ------------------------------------------------------------------------------
# Used only during initial database bootstrap/seeding
SUPER_ADMIN_EMAIL=superadmin@digitalghuru.com
SUPER_ADMIN_DEFAULT_PASSWORD="ReplaceWithStrongInitialPassword#2026"
SUPER_ADMIN_NAME="Digital Guru Platform Administrator"
