datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  FRANCHISE_OWNER
  BRANCH_ADMIN
  ACADEMIC_ADMIN
  STAFF
  PARENT
  STUDENT
}

enum FranchiseStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum AgreementStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  SUSPENDED
  TERMINATED
}

enum AgreementBusinessModel {
  NEW_CENTRE_JOINT_INVESTMENT
  EXISTING_CENTRE
  BRAND_AND_COURSE_SUPPORT
  CUSTOM_AGREEMENT
}

enum RevenueCalculationBasis {
  GROSS_COURSE_FEES
  NET_COURSE_REVENUE
  PROFIT_AFTER_EXPENSES
}

enum SettlementFrequency {
  MONTHLY
  YEARLY
}

enum ExpensePayerRole {
  DIGITAL_GURU
  PARTNER
  SHARED
  CUSTOM
}

enum RoyaltyFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum RoyaltyBasis {
  TOTAL_COLLECTIONS
  TUITION_FEES_ONLY
  NET_REVENUE
}

enum RoyaltyPaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum InstallmentStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum InstituteStatus {
  ACTIVE
  SUSPENDED
  PENDING_SETUP
}

enum StudentStatus {
  ACTIVE
  PASSED_OUT
  DISCONTINUED
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceMethod {
  MANUAL
  QR_SCAN
  VOICE_CONFIRMED
}

enum FeeFrequency {
  MONTHLY
  TERM_WISE
  ONE_TIME
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum MaterialType {
  PDF
  IMAGE
  AUDIO
  VOICE_NOTE
  TEXT
  DOCUMENT
  HOMEWORK
  ANNOUNCEMENT
}

enum NotificationType {
  ATTENDANCE
  ACADEMIC
  GENERAL
  MESSAGE
}

enum PushDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  NOT_CONFIGURED
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  COMPLETED
  LATE
  GRADED
  RESUBMISSION_REQUESTED
}

// -------------------------------------------------------------
// CORE & MULTI-TENANCY MODELS
// -------------------------------------------------------------

model Institute {
  id              String          @id @default(uuid())
  code            String          @unique // e.g., "INST-001"
  name            String
  legalName       String?
  address         String?
  city            String?
  state           String?
  postalCode      String?
  phone           String?
  email           String?
  status          InstituteStatus @default(ACTIVE)
  logoUrl         String?
  admissionPrefix String?         @unique // Stable abbreviation used for automatic student admission numbers
  settingsJson    Json?           // Dynamic settings like timezones, SMS templates, academic terms

  // GPS Geofence & Staff Attendance Configuration
  latitude                Float?
  longitude               Float?
  geofenceRadius          Float                  @default(200) // in metres
  locationVerified        Boolean                @default(false)
  workingDays             String                 @default("MON,TUE,WED,THU,FRI,SAT")
  workStartTime           String                 @default("09:00")
  workEndTime             String                 @default("18:00")
  lateGraceMinutes        Int                    @default(15)
  gpsAccuracyThreshold    Float                  @default(50) // Max horizontal accuracy in metres
  requireCheckoutGeofence Boolean                @default(true)
  allowStaffWfhRequests   Boolean                @default(true)
  timezone                String                 @default("Asia/Kolkata")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  memberships             InstituteMembership[]
  staffProfiles           StaffProfile[]
  students                Student[]
  admissionSequences      AdmissionSequence[]
  subjects                Subject[]
  batches                 Batch[]
  attendanceEvents        AttendanceEvent[]
  learningMaterials       LearningMaterial[]
  examinations            Examination[]
  quizzes                 Quiz[]
  progressFeedbacks       ProgressFeedback[]
  parentReviews           ParentReview[]
  parentFeedbacks         ParentFeedback[]
  conversations           Conversation[]
  feeStructures           FeeStructure[]
  payments                Payment[]
  paymentAdjustments      PaymentAdjustment[]
  auditLogs               AuditLog[]
  smsNotifications        SmsNotification[]
  staffDocuments          StaffDocument[]
  notifications           Notification[]
  inAppNotifications      InAppNotification[]
  onlinePaymentOrders     OnlinePaymentOrder[]
  staffAttendanceSessions StaffAttendanceSession[]
  wfhAuthorizations       StaffWFHAuthorization[]
  onlineClassLogs         StaffOnlineClassLog[]
  franchiseId             String?
  franchise               Franchise?             @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  royaltyRecords          FranchiseRoyaltyRecord[]

  @@index([status])
  @@index([name])
  @@index([franchiseId])
}

model User {
  id                 String    @id @default(uuid())
  email              String?   @unique
  phone              String?   @unique
  passwordHash       String
  role               UserRole
  fullName           String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships               InstituteMembership[]
  staffProfile              StaffProfile?
  parentProfile             ParentProfile?
  studentProfile            Student?
  markedAttendances         AttendanceEvent[]        @relation("MarkedByStaff")
  uploadedMaterials         LearningMaterial[]       @relation("UploadedByStaff")
  createdQuizzes            Quiz[]                   @relation("QuizCreator")
  enteredMarks              ExamMark[]               @relation("EvaluatedByStaff")
  feedbacksGiven            ProgressFeedback[]       @relation("StaffFeedback")
  reviewsReceived           ParentReview[]           @relation("StaffReviews")
  feedbacksReceived         ParentFeedback[]         @relation("FeedbackTargetStaff")
  feedbacksResponded        ParentFeedback[]         @relation("FeedbackRespondedBy")
  gradedSubmissions         HomeworkSubmission[]     @relation("GradedByStaff")
  conversationMembers       ConversationMember[]
  sentMessages              Message[]
  receivedPayments          Payment[]                @relation("RecordedByStaff")
  authorizedAdjusts         PaymentAdjustment[]      @relation("AuthorizedByStaff")
  passwordResetTokens       PasswordResetToken[]
  createdStudents           Student[]                @relation("StudentCreator")
  notifications             Notification[]
  devicePushTokens          DevicePushToken[]
  auditLogs                 AuditLog[]
  inAppNotifications        InAppNotification[]
  correctedStaffAttendances StaffAttendanceSession[] @relation("StaffAttendanceCorrector")
  wfhRequestsRequested      StaffWFHAuthorization[]  @relation("WFHRequestedBy")
  wfhRequestsApproved       StaffWFHAuthorization[]  @relation("WFHApprovedBy")
  wfhRequestsRejected       StaffWFHAuthorization[]  @relation("WFHRejectedBy")
  wfhRequestsRevoked        StaffWFHAuthorization[]  @relation("WFHRevokedBy")
  ownedFranchises           Franchise[]              @relation("FranchiseOwner")
  recordedRoyaltyPayments   FranchiseRoyaltyPayment[] @relation("RoyaltyPaymentRecorder")

  @@index([role])
  @@index([email])
  @@index([phone])
}

model InstituteMembership {
  id          String   @id @default(uuid())
  instituteId String
  userId      String
  role        UserRole
  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([instituteId, userId])
  @@index([instituteId])
  @@index([userId])
}

// -------------------------------------------------------------
// PROFILES: STAFF, PARENT, STUDENT
// -------------------------------------------------------------

model StaffProfile {
  id              String  @id @default(uuid())
  instituteId     String
  userId          String  @unique
  employeeCode    String?
  designation     String? // e.g., Senior Mathematics Teacher
  qualification   String?
  permissionsJson Json? // Fine-grained permission flags

  // Personal Details
  dob                      DateTime?
  gender                   String? // "Male", "Female", "Other", "Prefer not to say"
  altPhone                 String?
  personalEmail            String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  avatarUrl                String?

  // Current Address
  currentAddressLine1 String?
  currentAddressLine2 String?
  currentCity         String?
  currentState        String?
  currentPostalCode   String?
  currentCountry      String? @default("India")

  // Permanent Address
  permanentAddressLine1 String?
  permanentAddressLine2 String?
  permanentCity         String?
  permanentState        String?
  permanentPostalCode   String?
  permanentCountry      String? @default("India")
  sameAsCurrentAddress  Boolean @default(false)

  // Employment Details
  department       String? // e.g., "Science", "Mathematics", "Humanities"
  employmentType   String?   @default("FULL_TIME") // "FULL_TIME", "PART_TIME", "CONTRACT", "VISITING"
  joiningDate      DateTime? @default(now())
  probationEndDate DateTime?
  workLocation     String? // Branch/Campus
  employmentNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institute           Institute                @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments         StaffBatchAssignment[]
  batchSubjects       BatchSubject[]
  qualifications      StaffQualification[]
  experiences         StaffExperience[]
  documents           StaffDocument[]
  attendanceSessions  StaffAttendanceSession[]
  wfhAuthorizations   StaffWFHAuthorization[]
  wfhGroupAssignments WFHAuthorizationStaff[]
  StaffOnlineClassLog StaffOnlineClassLog[]

  @@unique([instituteId, employeeCode])
  @@index([instituteId])
  @@index([instituteId, department])
  @@index([instituteId, designation])
}

model StaffQualification {
  id             String   @id @default(uuid())
  staffProfileId String
  degree         String // Degree / Certification name
  fieldOfStudy   String? // Specialization / Major
  institution    String // College / University
  yearOfPassing  Int?
  gradeOrScore   String?
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId])
}

model StaffExperience {
  id              String   @id @default(uuid())
  staffProfileId  String
  institutionName String // Previous employer
  designation     String // Previous role
  startYear       Int?
  endYear         Int?
  subjectsTaught  String?
  totalYears      Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([staffProfileId])
}

model StaffDocument {
  id             String    @id @default(uuid())
  staffProfileId String
  instituteId    String
  documentType   String // "QUALIFICATION_CERTIFICATE", "EMPLOYMENT_AGREEMENT", "IDENTITY_PROOF", "EXPERIENCE_CERTIFICATE", "OTHER"
  displayName    String
  fileUrl        String
  fileName       String
  fileSize       Int?
  mimeType       String?
  expiryDate     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  institute    Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([staffProfileId])
  @@index([instituteId])
}

model ParentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  occupation      String?
  address         String?
  altPhone        String?
  isPhoneVerified Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentRelations StudentParentRelation[]
  parentReviews    ParentReview[]
  feedbacks        ParentFeedback[]
  smsNotifications SmsNotification[]
}

model Student {
  id              String        @id @default(uuid())
  instituteId     String
  userId          String?       @unique // Optional student login account
  admissionNumber String
  rollNumber      String?
  firstName       String
  lastName        String
  dob             DateTime?
  gender          String? // "MALE", "FEMALE", "OTHER"
  bloodGroup      String?
  phone           String?
  status          StudentStatus @default(ACTIVE)
  admissionDate   DateTime      @default(now())
  photoUrl        String?
  createdByUserId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  institute            Institute               @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user                 User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByUser        User?                   @relation("StudentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  parentRelations      StudentParentRelation[]
  enrollments          StudentEnrollment[]
  attendanceEvents     AttendanceEvent[]
  examMarks            ExamMark[]
  progressFeedbacks    ProgressFeedback[]
  parentReviews        ParentReview[]
  parentFeedbacks      ParentFeedback[]
  homeworkSubmissions  HomeworkSubmission[]
  materialInteractions MaterialInteraction[]
  quizAttempts         QuizAttempt[]
  feeAssignments       StudentFeeAssignment[]
  payments             Payment[]
  smsNotifications     SmsNotification[]
  notifications        Notification[]
  onlinePaymentOrders  OnlinePaymentOrder[]
  conversations        Conversation[]

  @@unique([instituteId, admissionNumber])
  @@index([instituteId])
  @@index([instituteId, status])
  @@index([status])
  @@index([firstName, lastName])
  @@index([createdByUserId])
}

model StudentParentRelation {
  id               String           @id @default(uuid())
  studentId        String
  parentId         String
  relation         GuardianRelation @default(GUARDIAN)
  isPrimaryContact Boolean          @default(false)
  canReceiveSms    Boolean          @default(true)
  createdAt        DateTime         @default(now())

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
}

// -------------------------------------------------------------
// ACADEMICS: SUBJECTS, BATCHES, ENROLLMENTS
// -------------------------------------------------------------

model Subject {
  id          String   @id @default(uuid())
  instituteId String
  name        String
  code        String? // e.g., "MATH-10"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute         Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batchSubjects     BatchSubject[]
  enrollments       StudentEnrollment[]
  learningMaterials LearningMaterial[]
  examinations      Examination[]
  quizzes           Quiz[]
  progressFeedbacks ProgressFeedback[]

  @@unique([instituteId, name])
  @@index([instituteId])
}

model Batch {
  id           String    @id @default(uuid())
  instituteId  String
  name         String // e.g., "Class 10 - Batch A (2026-27)"
  code         String? // Batch code, unique per institute (e.g., "B-10A")
  academicYear String // e.g., "2026-2027"
  startDate    DateTime
  endDate      DateTime?
  description  String?
  schedule     String? // Timing / schedule e.g., "Mon-Fri 4:00 PM - 6:00 PM"
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  institute         Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batchSubjects     BatchSubject[]
  staffAssignments  StaffBatchAssignment[]
  enrollments       StudentEnrollment[]
  attendanceEvents  AttendanceEvent[]
  learningMaterials LearningMaterial[]
  examinations      Examination[]
  quizzes           Quiz[]
  progressFeedbacks ProgressFeedback[]
  feeStructures     FeeStructure[]

  @@unique([instituteId, name, academicYear])
  @@index([instituteId])
  @@index([instituteId, code])
}

model BatchSubject {
  id             String   @id @default(uuid())
  batchId        String
  subjectId      String
  staffProfileId String?
  description    String?
  schedule       String?
  meetingLink    String?  @db.VarChar(500)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  batch               Batch                 @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject             Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  staffProfile        StaffProfile?         @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  StaffOnlineClassLog StaffOnlineClassLog[]

  @@unique([batchId, subjectId])
  @@index([batchId])
  @@index([subjectId])
}

model StaffBatchAssignment {
  id             String   @id @default(uuid())
  staffProfileId String
  batchId        String
  assignedAt     DateTime @default(now())

  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, batchId])
}

model StudentEnrollment {
  id         String   @id @default(uuid())
  studentId  String
  batchId    String
  subjectId  String? // Optional subject-specific enrollment
  enrolledAt DateTime @default(now())
  isActive   Boolean  @default(true)

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([studentId, batchId, subjectId])
  @@index([studentId])
  @@index([batchId])
}

// -------------------------------------------------------------
// ATTENDANCE & SMS NOTIFICATIONS
// -------------------------------------------------------------

model AttendanceEvent {
  id             String           @id @default(uuid())
  instituteId    String
  studentId      String
  batchId        String
  eventDate      DateTime         @db.Date
  eventType      AttendanceType
  eventTime      DateTime         @default(now())
  sessionNumber  Int              @default(1)
  method         AttendanceMethod @default(MANUAL)
  isLate         Boolean          @default(false)
  isCorrected    Boolean          @default(false)
  correctionNote String?
  idempotencyKey String?          @unique
  markedById     String
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  institute        Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch            Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  markedBy         User              @relation("MarkedByStaff", fields: [markedById], references: [id])
  smsNotifications SmsNotification[]
  notifications    Notification[]

  @@unique([studentId, eventDate, eventType, sessionNumber])
  @@index([instituteId, eventDate])
  @@index([batchId, eventDate])
  @@index([studentId, eventDate])
}

model SmsNotification {
  id                String             @id @default(uuid())
  instituteId       String
  parentId          String
  studentId         String
  attendanceEventId String?
  phoneNumber       String
  templateName      String // e.g., "CHECK_IN_NOTIFICATION"
  messageBody       String
  provider          String             @default("mock")
  providerRef       String?
  status            NotificationStatus @default(QUEUED)
  failureReason     String?
  retryCount        Int                @default(0)
  maxRetries        Int                @default(3)
  scheduledRetryAt  DateTime?
  idempotencyKey    String?            @unique
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime           @default(now())

  institute       Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  parent          ParentProfile    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceEvent AttendanceEvent? @relation(fields: [attendanceEventId], references: [id], onDelete: SetNull)

  @@index([instituteId, status])
  @@index([attendanceEventId])
  @@index([scheduledRetryAt])
}

model Notification {
  id                 String             @id @default(uuid())
  instituteId        String
  userId             String
  role               UserRole
  title              String
  message            String
  type               NotificationType   @default(ATTENDANCE)
  studentId          String?
  attendanceEventId  String?
  eventType          AttendanceType?
  eventTime          DateTime?
  isRead             Boolean            @default(false)
  readAt             DateTime?
  pushStatus         PushDeliveryStatus @default(PENDING)
  pushError          String?
  link               String?
  entityType         String?
  entityId           String?
  metadata           Json?
  idempotencyKey     String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  institute          Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  student         Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceEvent AttendanceEvent? @relation(fields: [attendanceEventId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([instituteId, createdAt])
  @@index([attendanceEventId])
  @@index([studentId])
  @@index([entityType, entityId])
}

model DevicePushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String   @default("android")
  deviceInfo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------------
// LEARNING MATERIALS & EXAMINATIONS
// -------------------------------------------------------------

model LearningMaterial {
  id          String       @id @default(uuid())
  instituteId String
  batchId     String
  subjectId   String?
  uploaderId  String
  title       String
  description String?
  content     String?
  type        MaterialType
  isPublished Boolean      @default(true)
  publishedAt DateTime?
  fileUrl     String? // Private object storage path/key
  fileName    String?
  fileSize    Int? // bytes
  mimeType    String?
  dueDate     DateTime? // If homework
  maxMarks    Decimal?     @db.Decimal(5, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  institute   Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch       Batch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject     Subject?             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploader    User                 @relation("UploadedByStaff", fields: [uploaderId], references: [id])
  submissions HomeworkSubmission[]
  interactions MaterialInteraction[]

  @@index([instituteId, batchId])
  @@index([type])
}

model Examination {
  id                 String    @id @default(uuid())
  instituteId        String
  batchId            String
  subjectId          String
  title              String
  examType           String // e.g., "Unit Test", "Term Exam", "Monthly Assessment"
  totalMarks         Decimal   @db.Decimal(5, 2)
  passingMarks       Decimal   @db.Decimal(5, 2)
  examDate           DateTime  @db.Date
  academicYear       String?
  description        String?
  startTime          String?
  endTime            String?
  instructions       String?
  fileUrl            String?
  fileName           String?
  fileSize           Int?
  mimeType           String?
  status             String    @default("DRAFT")
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  isResultsPublished Boolean   @default(false)
  resultsPublishedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  institute Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch     Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks     ExamMark[]

  @@index([instituteId, batchId])
}

model HomeworkSubmission {
  id           String           @id @default(uuid())
  materialId   String
  studentId    String
  status       SubmissionStatus @default(SUBMITTED)
  submittedAt  DateTime         @default(now())
  isLate       Boolean          @default(false)
  fileUrl      String?
  fileName     String?
  fileSize     Int?
  mimeType     String?
  studentNotes String?
  grade        String?
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy User?            @relation("GradedByStaff", fields: [gradedById], references: [id])

  @@unique([materialId, studentId])
  @@index([studentId])
  @@index([materialId])
}

model ExamMark {
  id            String   @id @default(uuid())
  examId        String
  studentId     String
  marksObtained Decimal  @db.Decimal(5, 2)
  isAbsent      Boolean  @default(false)
  remarks       String?
  isPublished   Boolean  @default(false)
  evaluatedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam        Examination @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluatedBy User        @relation("EvaluatedByStaff", fields: [evaluatedById], references: [id])

  @@unique([examId, studentId])
  @@index([studentId])
}

model ProgressFeedback {
id              String    @id @default(uuid())
  instituteId     String
  studentId       String
  batchId         String
  subjectId       String?
  staffId         String
  termName        String // e.g., "Weekly Review", "Monthly Progress", "Quarter 1", "Midterm"
  periodType      String?   @default("TERM") // "WEEKLY", "MONTHLY", "TERM", "ANNUAL"
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  remarks         String
  rating          Int? // 1 to 5 scale
  strengths       String?
  improvements    String?
  recommendations String?
  attendanceRate  Decimal?  @db.Decimal(5, 2) // Auto-calculated attendance %
  homeworkRate    Decimal?  @db.Decimal(5, 2) // Auto-calculated homework %
  examAverage     Decimal?  @db.Decimal(5, 2) // Auto-calculated exam %
  status          String    @default("PUBLISHED") // "DRAFT", "PUBLISHED", "ARCHIVED"
  isPublished     Boolean   @default(true)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch     Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  staff     User      @relation("StaffFeedback", fields: [staffId], references: [id])

  @@index([studentId])
  @@index([batchId])
  @@index([subjectId])
}

model ParentReview {
id              String    @id @default(uuid())
  instituteId     String
  parentId        String
  studentId       String?
  staffId         String?
  type            String    @default("FEEDBACK") // "FEEDBACK" (Private inquiry) or "TESTIMONIAL" (Public review)
  subject         String? // Subject / topic of the feedback
  category        String?   @default("GENERAL") // "ACADEMIC", "FACILITIES", "SCHEDULE", "BEHAVIOR", "BILLING", "GENERAL"
  rating          Int? // 1 to 5
  reviewText      String // The message/feedback text
  replyText       String? // Response from staff/admin
  repliedAt       DateTime?
  repliedById     String?
  status          String    @default("NEW") // "NEW", "REPLIED", "RESOLVED", "PENDING", "APPROVED", "PUBLISHED", "ARCHIVED"
  isPublicConsent Boolean   @default(false) // Consent for public showcase
  isPublished     Boolean   @default(false) // Whether approved for public viewing
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  institute Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff     User?         @relation("StaffReviews", fields: [staffId], references: [id])

  @@index([instituteId])
  @@index([parentId])
  @@index([studentId])
}

// -------------------------------------------------------------
// MESSAGING & COMMUNICATION
// -------------------------------------------------------------

model Conversation {
  id          String   @id @default(uuid())
  instituteId String
  studentId   String? // Associated student
  title       String? // Optional subject/title
  isGroup     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institute Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  members   ConversationMember[]
  messages  Message[]

  @@index([instituteId])
  @@index([studentId])
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  attachmentType String? // "IMAGE" | "AUDIO" | "DOCUMENT"
  attachmentName String?
  attachmentSize Int?
  clientTempId   String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([clientTempId])
}

// -------------------------------------------------------------
// FEES & FINANCIAL AUDIT
// -------------------------------------------------------------

model FeeStructure {
  id           String       @id @default(uuid())
  instituteId  String
  batchId      String
  name         String // e.g., "Monthly Tuition - Class 10"
  description  String?
  academicYear String?
  frequency    FeeFrequency
  amount       Decimal      @db.Decimal(10, 2)
  dueDay       Int? // Day of month (1-31)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  institute   Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch       Batch                  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  assignments StudentFeeAssignment[]

  @@index([instituteId])
}

model StudentFeeAssignment {
  id             String        @id @default(uuid())
  studentId      String
  feeStructureId String
  termLabel      String? // e.g., "October 2026", "Term 1"
  academicYear   String?
  baseAmount     Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  finalAmount    Decimal       @db.Decimal(10, 2)
  dueDate        DateTime      @db.Date
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure        FeeStructure         @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  payments            Payment[]
  adjustments         PaymentAdjustment[]
  onlinePaymentOrders OnlinePaymentOrder[]

  @@unique([studentId, feeStructureId, termLabel])
  @@index([status])
  @@index([studentId])
}

model Payment {
  id                   String        @id @default(uuid())
  instituteId          String
  studentId            String
  feeAssignmentId      String
  receiptNumber        String        @unique // e.g., "REC-2026-0001"
  amountPaid           Decimal       @db.Decimal(10, 2)
  method               PaymentMethod
  transactionReference String? // UPI Ref / Cheque No / Bank Ref
  idempotencyKey       String?       @unique
  status               String        @default("SUCCESS")
  paidAt               DateTime      @default(now())
  recordedById         String
  remarks              String?
  createdAt            DateTime      @default(now())

  institute     Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeAssignment StudentFeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)
  recordedBy    User                 @relation("RecordedByStaff", fields: [recordedById], references: [id])
  adjustments   PaymentAdjustment[]

  @@index([instituteId, paidAt])
  @@index([studentId])
}

model PaymentAdjustment {
  id              String   @id @default(uuid())
  instituteId     String?
  paymentId       String?
  feeAssignmentId String?
  adjustmentType  String // "REFUND", "DISCOUNT", "CORRECTION"
  amount          Decimal  @db.Decimal(10, 2)
  reason          String
  authorizedById  String
  createdAt       DateTime @default(now())

  institute     Institute?            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  payment       Payment?              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  feeAssignment StudentFeeAssignment? @relation(fields: [feeAssignmentId], references: [id], onDelete: SetNull)
  authorizedBy  User                  @relation("AuthorizedByStaff", fields: [authorizedById], references: [id])

  @@index([instituteId])
  @@index([paymentId])
  @@index([feeAssignmentId])
}

// -------------------------------------------------------------
// SECURITY, SESSIONS & AUDIT LOGGING
// -------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

model AuditLog {
  id          String   @id @default(uuid())
  instituteId String?
  userId      String?
  action      String // e.g., "FEE_PAYMENT_RECORDED", "ATTENDANCE_CORRECTED", "USER_CREATED"
  entityType  String // e.g., "Payment", "AttendanceEvent", "Student"
  entityId    String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([instituteId, createdAt])
  @@index([entityType, entityId])
}

// -------------------------------------------------------------
// ADMISSION SEQUENCE COUNTER (CONCURRENCY-SAFE)
// -------------------------------------------------------------

model AdmissionSequence {
  id          String   @id @default(uuid())
  instituteId String
  year        Int
  lastSerial  Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, year])
  @@index([instituteId, year])
}

// -------------------------------------------------------------
// IN-APP NOTIFICATIONS & ONLINE PAYMENTS
// -------------------------------------------------------------

model InAppNotification {
  id          String    @id @default(uuid())
  instituteId String
  userId      String
  studentId   String?
  type        String // e.g. "ABSENCE", "NEW_MESSAGE", "TEST_RESULT", "FEE_DUE", "FEE_PAID", "ANNOUNCEMENT"
  title       String
  message     String
  link        String?
  entityType  String?
  entityId    String?
  metadata    Json?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([instituteId, createdAt])
}

model OnlinePaymentOrder {
  id               String   @id @default(uuid())
  instituteId      String
  studentId        String
  feeAssignmentId  String
  orderId          String   @unique
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("INR")
  status           String   @default("PENDING")
  receiptNumber    String?
  gatewayPaymentId String?
  gatewaySignature String?
  paymentId        String?
  idempotencyKey   String?  @unique
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institute     Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeAssignment StudentFeeAssignment @relation(fields: [feeAssignmentId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([studentId])
  @@index([orderId])
  @@index([status])
}

// -------------------------------------------------------------
// PARENT FEEDBACK MANAGEMENT (FEATURE D)
// -------------------------------------------------------------

model ParentFeedback {
  id              String    @id @default(uuid())
  instituteId     String
  parentId        String
  studentId       String
  staffId         String? // Target teacher/staff (User.id)
  category        String // "Academic Progress", "Teaching Method", "Attendance", "Student Behaviour", "Homework", "General Feedback"
  feedbackText    String
  status          String    @default("OPEN") // "OPEN", "RESPONDED", "RESOLVED"
  teacherResponse String?
  respondedAt     DateTime?
  respondedById   String? // User.id of responder
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  institute   Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  parent      ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff       User?         @relation("FeedbackTargetStaff", fields: [staffId], references: [id], onDelete: SetNull)
  respondedBy User?         @relation("FeedbackRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([instituteId])
  @@index([studentId])
  @@index([parentId])
  @@index([staffId])
  @@index([status])
}

// -------------------------------------------------------------
// STAFF ATTENDANCE & GPS GEOFENCING MODELS
// -------------------------------------------------------------

enum StaffAttendanceMode {
  ON_SITE
  WFH
}

enum WFHAuthorizationScope {
  INSTITUTE_WIDE
  INDIVIDUAL
  GROUP
}

enum WFHAuthorizationStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
}

enum WFHReasonCategory {
  WEATHER_DISRUPTION
  ONLINE_CLASSES
  INSTITUTE_CLOSURE
  INDIVIDUAL_REQUEST
  MANAGEMENT_APPROVAL
  OTHER
}

enum StaffAttendanceStatus {
  NOT_CHECKED_IN
  CHECKED_IN
  CHECKED_OUT
  LATE
  INCOMPLETE
  ABSENT
  ON_LEAVE
  MANUALLY_CORRECTED
}

enum StaffAttendanceEventType {
  CHECK_IN
  CHECK_OUT
  MANUAL_CORRECTION
  SYSTEM_FLAG
}

model StaffAttendanceSession {
  id                  String                @id @default(uuid())
  instituteId         String
  staffId             String
  attendanceDate      DateTime              @db.Date
  status              StaffAttendanceStatus @default(CHECKED_IN)
  checkInTime         DateTime?
  checkOutTime        DateTime?
  workDurationMinutes Int                   @default(0)
  isLate              Boolean               @default(false)
  isManuallyCorrected Boolean               @default(false)
  correctionReason    String?
  correctedById       String?
  correctedAt         DateTime?
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  institute          Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  staff              StaffProfile           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  correctedBy        User?                  @relation("StaffAttendanceCorrector", fields: [correctedById], references: [id], onDelete: SetNull)
  attendanceMode     StaffAttendanceMode    @default(ON_SITE)
  wfhAuthorizationId String?
  wfhAuthorization   StaffWFHAuthorization? @relation(fields: [wfhAuthorizationId], references: [id], onDelete: SetNull)
  events             StaffAttendanceEvent[]

  @@unique([instituteId, staffId, attendanceDate])
  @@index([instituteId, attendanceDate])
  @@index([staffId])
  @@index([status])
  @@index([attendanceMode])
  @@index([instituteId, status, attendanceDate])
}

model StaffAttendanceEvent {
  id                 String                   @id @default(uuid())
  sessionId          String
  instituteId        String
  staffId            String
  eventType          StaffAttendanceEventType
  serverTimestamp    DateTime                 @default(now())
  latitude           Float?
  longitude          Float?
  accuracy           Float?
  distanceFromCenter Float? // Distance in metres from institute coordinates
  isWithinGeofence   Boolean                  @default(false)
  validationOutcome  String // e.g., "VERIFIED_INSIDE_GEOFENCE", "REJECTED_OUTSIDE_GEOFENCE", "MANUAL_ADJUSTMENT"
  deviceInfo         String?
  remarks            String?
  idempotencyKey     String?                  @unique
  createdAt          DateTime                 @default(now())

  attendanceMode     StaffAttendanceMode?   @default(ON_SITE)
  wfhAuthorizationId String?
  wfhAuthorization   StaffWFHAuthorization? @relation(fields: [wfhAuthorizationId], references: [id], onDelete: SetNull)
  session            StaffAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([staffId])
  @@index([instituteId, serverTimestamp])
}

model StaffWFHAuthorization {
  id               String                 @id @default(uuid())
  instituteId      String
  institute        Institute              @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  staffId          String?
  staff            StaffProfile?          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  scope            WFHAuthorizationScope  @default(INDIVIDUAL)
  startDate        DateTime               @db.Date
  endDate          DateTime               @db.Date
  reasonCategory   WFHReasonCategory      @default(INDIVIDUAL_REQUEST)
  reason           String                 @db.Text
  notes            String?                @db.Text
  status           WFHAuthorizationStatus @default(PENDING)
  requestedById    String?
  requestedBy      User?                  @relation("WFHRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedById     String?
  approvedBy       User?                  @relation("WFHApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  rejectionReason  String?                @db.Text
  rejectedById     String?
  rejectedBy       User?                  @relation("WFHRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt       DateTime?
  revocationReason String?                @db.Text
  revokedById      String?
  revokedBy        User?                  @relation("WFHRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  sessions         StaffAttendanceSession[]
  events           StaffAttendanceEvent[]
  groupAssignments WFHAuthorizationStaff[]

  @@index([instituteId, startDate, endDate])
  @@index([instituteId, staffId, status])
  @@index([instituteId, scope, status])
}

model WFHAuthorizationStaff {
  id              String                @id @default(uuid())
  authorizationId String
  authorization   StaffWFHAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  staffId         String
  staff           StaffProfile          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt       DateTime              @default(now())

  @@unique([authorizationId, staffId])
  @@index([staffId])
}

model StaffOnlineClassLog {
  id             String   @id @default(uuid())
  instituteId    String
  staffId        String
  batchSubjectId String
  deliveryDate   DateTime @db.Date
  status         String   @default("SCHEDULED")
  notes          String?  @db.Text
  meetingLink    String?  @db.VarChar(500)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  institute    Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  staff        StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  batchSubject BatchSubject @relation(fields: [batchSubjectId], references: [id], onDelete: Cascade)

  @@unique([staffId, batchSubjectId, deliveryDate])
  @@index([instituteId, deliveryDate])
}

model MaterialInteraction {
  id              String   @id @default(uuid())
  materialId      String
  studentId       String
  interactionType String // "OPENED", "AUDIO_PLAYING", "AUDIO_COMPLETED", "DOWNLOADED"
  progressPercent Float?
  durationSeconds Float?
  lastPositionSec Float?
  isCompleted     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([materialId, studentId, interactionType])
  @@index([studentId])
  @@index([materialId])
}

// -------------------------------------------------------------
// QUIZZES & ASSESSMENTS
// -------------------------------------------------------------

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  EXPIRED
}

model Quiz {
  id                String     @id @default(uuid())
  instituteId       String
  batchId           String
  subjectId         String?
  creatorId         String
  title             String
  instructions      String?
  durationMinutes   Int? // Optional time limit in minutes
  totalMarks        Decimal    @default(100) @db.Decimal(5, 2)
  passingMarks      Decimal?   @db.Decimal(5, 2)
  status            QuizStatus @default(DRAFT)
  isPublished       Boolean    @default(false)
  publishedAt       DateTime?
  resultsReleased   Boolean    @default(false)
  resultsReleasedAt DateTime?
  startTime         DateTime?
  endTime           DateTime?
  maxAttempts       Int        @default(1)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  institute Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  batch     Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  creator   User           @relation("QuizCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([instituteId, batchId])
  @@index([status])
}

model QuizQuestion {
  id           String       @id @default(uuid())
  quizId       String
  questionText String
  questionType QuestionType @default(SINGLE_CHOICE)
  marks        Decimal      @default(1) @db.Decimal(5, 2)
  orderIndex   Int          @default(0)
  explanation  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId])
}

model QuizOption {
  id         String  @id @default(uuid())
  questionId String
  optionText String
  isCorrect  Boolean @default(false)
  orderIndex Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id            String            @id @default(uuid())
  quizId        String
  studentId     String
  attemptNumber Int               @default(1)
  status        QuizAttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime          @default(now())
  submittedAt   DateTime?
  score         Decimal?          @db.Decimal(5, 2)
  totalMarks    Decimal?          @db.Decimal(5, 2)
  percentage    Decimal?          @db.Decimal(5, 2)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, studentId, attemptNumber])
  @@index([quizId])
  @@index([studentId])
}

model QuizAnswer {
  id                String   @id @default(uuid())
  attemptId         String
  questionId        String
  selectedOptionIds Json // Array of selected option IDs e.g. ["opt-1"]
  isCorrect         Boolean?
  marksAwarded      Decimal? @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}


// -------------------------------------------------------------


// -------------------------------------------------------------
// FRANCHISE, AGREEMENTS & ROYALTY MANAGEMENT
// -------------------------------------------------------------

model Franchise {
  id                String          @id @default(uuid())
  code              String          @unique // e.g. "DG-FR-1001"
  name              String
  ownerName         String
  email             String          @unique
  phone             String
  address           String?
  city              String?
  state             String?
  postalCode        String?
  country           String?         @default("India")
  authorizedContact Json?           // { name, phone, email, designation }
  businessDetails   Json?           // GSTIN, PAN, Bank Details, Entity Type, Registration
  status            FranchiseStatus @default(ACTIVE)
  ownerUserId       String?
  ownerUser         User?           @relation("FranchiseOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  branches          Institute[]
  agreements        FranchiseAgreement[]
  installments      FranchiseRoyaltyInstallment[]
  royaltyRecords    FranchiseRoyaltyRecord[]
  royaltyPayments   FranchiseRoyaltyPayment[]

  @@index([status])
  @@index([name])
  @@index([code])
}

model FranchiseAgreement {
  id                  String          @id @default(uuid())
  franchiseId         String
  franchise           Franchise       @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  agreementNumber     String          @unique // e.g. "AGR-2026-001"
  title               String
  startDate           DateTime        @db.Date
  endDate             DateTime        @db.Date
  annualRoyaltyAmount Decimal?        @db.Decimal(12, 2)
  calculationMethod   String?         @default("FIXED_ANNUAL") // FIXED_ANNUAL, PERCENTAGE_REVENUE, PER_STUDENT
  perStudentFee       Decimal?        @db.Decimal(10, 2)
  royaltyPercentage   Decimal         @default(50.00) @db.Decimal(5, 2) // Default 50%
  royaltyBasis        RoyaltyBasis    @default(TOTAL_COLLECTIONS)
  paymentFrequency    RoyaltyFrequency @default(ANNUAL)
  dueDay              Int             @default(10) // Day of the month
  installmentCount    Int             @default(2) // Exactly 2 installments per agreement year
  status              AgreementStatus @default(ACTIVE)
  documentUrl         String?         // URL/path to signed agreement
  documentName        String?
  terms               String?         @db.Text
  amendments          Json?           // History of amendments [{ date, changedBy, note, oldTerms, newTerms }]
  notes               String?         @db.Text
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // 1. Business Model Classification
  agreementType       AgreementBusinessModel @default(CUSTOM_AGREEMENT)

  // 2. Initial Investment Configuration
  totalInvestment                 Decimal?  @db.Decimal(12, 2)
  digitalGuruInvestmentAmount     Decimal?  @db.Decimal(12, 2)
  partnerInvestmentAmount         Decimal?  @db.Decimal(12, 2)
  digitalGuruInvestmentPercentage Decimal?  @db.Decimal(5, 2)
  partnerInvestmentPercentage     Decimal?  @db.Decimal(5, 2)
  operationalSetupContribution    Decimal?  @db.Decimal(12, 2)
  investmentNotes                 String?   @db.Text

  // 3. Revenue Sharing Configuration
  digitalGuruRevenuePercentage Decimal?                 @default(50.00) @db.Decimal(5, 2)
  partnerRevenuePercentage     Decimal?                 @default(50.00) @db.Decimal(5, 2)
  revenueCalculationBasis      RevenueCalculationBasis? @default(GROSS_COURSE_FEES)
  settlementFrequency          SettlementFrequency?     @default(YEARLY)

  // 4. Operational Expense Responsibilities (Structured JSON)
  expenseResponsibilities      Json?

  // 5. Marketing Support Configuration
  marketingResponsibleParty       ExpensePayerRole? @default(DIGITAL_GURU)
  marketingSupportDurationMonths  Int?              @default(3)
  marketingPostSupportParty       ExpensePayerRole? @default(PARTNER)
  marketingBudget                 Decimal?          @db.Decimal(12, 2)
  marketingEffectiveStartDate     DateTime?         @db.Date
  marketingNotes                  String?           @db.Text

  // 6. Course Software Access Entitlement
  courseSoftwareAccessEnabled Boolean  @default(true)
  courseSoftwarePricingNotes  String?  @db.Text

  // 7. Agreement Versioning & Revision History
  version             Int                   @default(1)
  parentAgreementId   String?
  parentAgreement     FranchiseAgreement?   @relation("AgreementVersions", fields: [parentAgreementId], references: [id], onDelete: SetNull)
  childAgreements     FranchiseAgreement[]  @relation("AgreementVersions")

  installments        FranchiseRoyaltyInstallment[]

  @@index([franchiseId])
  @@index([status])
  @@index([agreementNumber])
  @@index([endDate])
  @@index([agreementType])
  @@index([parentAgreementId])
}

model FranchiseRoyaltyInstallment {
  id                 String             @id @default(uuid())
  franchiseId        String
  franchise          Franchise          @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  agreementId        String
  agreement          FranchiseAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  installmentNumber  Int                // 1 or 2
  periodLabel        String             // e.g. "Installment 1 of 2 (H1)"
  startDate          DateTime           @db.Date
  endDate            DateTime           @db.Date
  dueDate            DateTime           @db.Date
  amount             Decimal            @db.Decimal(12, 2)
  paidAmount         Decimal            @default(0.00) @db.Decimal(12, 2)
  outstandingBalance Decimal            @db.Decimal(12, 2)
  status             InstallmentStatus  @default(UPCOMING)
  calculationBasis   String             // "FIXED_ANNUAL", "PERCENTAGE_REVENUE", "PER_STUDENT"
  calculationBreakdown Json?
  notes              String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  payments           FranchiseRoyaltyPayment[]

  @@unique([agreementId, installmentNumber])
  @@index([franchiseId])
  @@index([agreementId])
  @@index([status])
  @@index([dueDate])
}

model FranchiseRoyaltyRecord {
  id                 String               @id @default(uuid())
  franchiseId        String
  franchise          Franchise            @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  instituteId        String?
  institute          Institute?           @relation(fields: [instituteId], references: [id], onDelete: SetNull)
  periodLabel        String               // e.g. "2026-11", "November 2026"
  startDate          DateTime             @db.Date
  endDate            DateTime             @db.Date
  grossCollection    Decimal              @db.Decimal(12, 2)
  eligibleRevenue    Decimal              @db.Decimal(12, 2)
  royaltyPercentage  Decimal              @db.Decimal(5, 2)
  royaltyPayable     Decimal              @db.Decimal(12, 2)
  royaltyPaid        Decimal              @default(0.00) @db.Decimal(12, 2)
  outstandingBalance Decimal              @db.Decimal(12, 2)
  status             RoyaltyPaymentStatus @default(PENDING)
  dueDate            DateTime             @db.Date
  calculationDetails Json?                // Breakdown of underlying fee payments
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  payments           FranchiseRoyaltyPayment[]

  @@unique([franchiseId, periodLabel, instituteId])
  @@index([franchiseId])
  @@index([status])
  @@index([dueDate])
}

model FranchiseRoyaltyPayment {
  id                   String                       @id @default(uuid())
  franchiseId          String
  franchise            Franchise                    @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  royaltyRecordId      String?
  royaltyRecord        FranchiseRoyaltyRecord?      @relation(fields: [royaltyRecordId], references: [id], onDelete: SetNull)
  installmentId        String?
  installment          FranchiseRoyaltyInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  receiptNumber        String                       @unique // e.g. "ROY-REC-2026-0001"
  amountPaid           Decimal                      @db.Decimal(12, 2)
  paymentDate          DateTime                     @default(now())
  paymentMethod        PaymentMethod                @default(BANK_TRANSFER)
  transactionReference String?
  recordedById         String
  recordedBy           User                         @relation("RoyaltyPaymentRecorder", fields: [recordedById], references: [id])
  remarks              String?
  createdAt            DateTime                     @default(now())

  @@index([franchiseId])
  @@index([installmentId])
  @@index([paymentDate])
  @@index([receiptNumber])
}
