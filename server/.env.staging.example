# ==============================================================================
# DIGITALGHURU FRANCHISE — STAGING ENVIRONMENT CONFIGURATION (.env.staging.example)
# ==============================================================================
# Copy this file to `server/.env` when setting up the Staging environment.
# STRICT FINTECH RULE: Never point staging at the production financial database.
# Never use live Razorpay keys (rzp_live_*) in staging.

PORT=5000
HOST=0.0.0.0
NODE_ENV=staging
API_BASE_URL=https://staging-api.digitalghuru.com/api

# Allowed CORS origins for staging
CORS_ORIGIN=https://staging.digitalghuru.com,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# ISOLATED STAGING DATABASE (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# MUST be an isolated staging database or an isolated Neon branch (e.g. branch 'staging').
# DO NOT use the production database connection string here.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/staging_db?sslmode=require&connection_limit=10"

# ------------------------------------------------------------------------------
# JWT & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=staging_jwt_secret_min_32_characters_random_string_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=staging_refresh_secret_min_32_characters_random_string_here
REFRESH_TOKEN_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# STORAGE
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
ALLOW_EPHEMERAL_LOCAL_STORAGE=true

# ------------------------------------------------------------------------------
# NOTIFICATIONS
# ------------------------------------------------------------------------------
SMS_PROVIDER=mock

# ------------------------------------------------------------------------------
# RAZORPAY TEST MODE CREDENTIALS
# ------------------------------------------------------------------------------
# Obtain these from: Razorpay Dashboard -> Toggle to 'Test Mode' -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YOUR_TEST_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_TEST_KEY_SECRET_HERE

# Webhook secret configured when adding webhook URL in Razorpay Dashboard (Test Mode):
# Webhook URL: https://<your-staging-domain-or-ngrok>/api/webhooks/razorpay
# Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=YOUR_STAGING_WEBHOOK_SECRET_HERE

# ------------------------------------------------------------------------------
# ROUTE & DUAL CONTROL CONTROLS
# ------------------------------------------------------------------------------
# Route Payouts MUST remain false: settlements are processed via manual bank transfers
ENABLE_RAZORPAY_ROUTE=false

# Dual control is set to false in staging to allow single-admin testing.
# (In production, this must be set to true).
ENFORCE_TRANSFER_DUAL_CONTROL=false
