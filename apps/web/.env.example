# ==============================================================================
# DIGITAL GURU FRANCHISE — WEB FRONTEND CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env (or configure in Vercel/Netlify dashboard)

# Backend API Base URL
# For local development with Vite proxy: /api
# For production cross-domain: https://api.digitalghuru.com/api
VITE_API_URL=/api

# Demo Mode Control
# Set to 'false' (default) in production to completely disable 1-click demo credential autofill.
# Set to 'true' only in dedicated staging/demo sandbox environments.
VITE_ENABLE_DEMO_ACCOUNTS=false

